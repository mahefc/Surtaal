; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Surtaal"
config/description="Mobile music creation studio"
run/main_scene="res://scenes/studio/studio.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

buses/default_bus_layout=""
driver/output_latency=20
driver/enable_input=true

[autoload]

SampleManager="*res://scripts/audio/sample_manager.gd"
TuningManager="*res://scripts/music/tuning_manager.gd"
AudioEngine="*res://scripts/audio/audio_engine.gd"
InstrumentManager="*res://scripts/instruments/instrument_manager.gd"
Transport="*res://scripts/music/transport.gd"
TrackManager="*res://scripts/music/track_manager.gd"
RecordingManager="*res://scripts/recording/recording_manager.gd"
ProjectManager="*res://scripts/core/project_manager.gd"
ExportManager="*res://scripts/export/export_manager.gd"

[display]

window/size/viewport_width=860
window/size/viewport_height=400
window/size/window_width_override=960
window/size/window_height_override=480
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[importer_defaults]

wav={
"compress/mode": 0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
